<odoo noupdate="1">
    <record id="seq_payout" model="ir.sequence">
        <field name="name">Affiliate settlement</field>
        <field name="code">wa.payout</field>
        <field name="prefix">AFF/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="mail_affiliate_approved" model="mail.template">
        <field name="name">Affiliate application approved</field>
        <field name="model_id" ref="model_wa_affiliate"/>
        <field name="subject">Your affiliate application is approved</field>
        <field name="email_to">{{ object.partner_id.email or '' }}</field>
        <field name="email_from">{{ object.company_id.email or user.email_formatted or '' }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
            <div>
                <p>Hello <t t-out="object.partner_id.name"/>,</p>
                <p>Your application has been approved. Sign in and open the Affiliate Studio from your account to get your referral link.</p>
            </div>
        </field>
    </record>
    <record id="cron_affiliate_payment" model="ir.cron">
        <field name="name">Affiliates: check customer payments</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_affiliate_payments()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
    </record>
    <record id="cron_affiliate_release" model="ir.cron">
        <field name="name">Affiliates: release commissions</field>
        <field name="model_id" ref="model_wa_entry"/>
        <field name="state">code</field>
        <field name="code">model._release_due()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
    </record>
    <record id="cron_affiliate_payout" model="ir.cron">
        <field name="name">Affiliates: sync vendor bill payments</field>
        <field name="model_id" ref="model_wa_payout"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_payouts()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
    </record>
</odoo>